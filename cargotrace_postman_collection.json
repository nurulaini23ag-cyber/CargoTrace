{
  "info": {
    "_postman_id": "cargotrace-api-collection-v1",
    "name": "CargoTrace REST API - Web Programming 2 UAS",
    "description": "Comprehensive Postman collection for CargoTrace Global Shipment Visibility & Tracking Platform fulfilling all Slide 12 and 13 REST API requirements.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register Customer (POST /api/register)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Consignee\",\n  \"email\": \"alice@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"company_name\": \"Alice Trade International\"\n}"
            },
            "url": { "raw": "{{base_url}}/register" }
          }
        },
        {
          "name": "Login (POST /api/login)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('auth_token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"operator@cargotrace.test\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/login" }
          }
        },
        {
          "name": "Get Authenticated User (GET /api/user)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": { "raw": "{{base_url}}/user" }
          }
        },
        {
          "name": "Logout (POST /api/logout)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": { "raw": "{{base_url}}/logout" }
          }
        }
      ]
    },
    {
      "name": "Shipments",
      "item": [
        {
          "name": "List Shipments with Filter & Pagination (GET /api/shipments)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/shipments?page=1&per_page=10&status=IN_TRANSIT",
              "query": [
                { "key": "page", "value": "1" },
                { "key": "per_page", "value": "10" },
                { "key": "status", "value": "IN_TRANSIT" },
                { "key": "search", "value": "", "disabled": true },
                { "key": "is_delayed", "value": "true", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "Create Shipment (POST /api/shipments)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 3,\n  \"carrier_id\": 1,\n  \"origin_id\": 1,\n  \"destination_id\": 3,\n  \"cargo_type\": \"Medical Electronics\",\n  \"weight\": 14500,\n  \"volume\": 38.5,\n  \"expected_departure\": \"2026-11-01 08:00:00\",\n  \"expected_arrival\": \"2026-11-12 18:00:00\",\n  \"items\": [\n    {\n      \"item_description\": \"MRI Superconducting Magnet Components\",\n      \"quantity\": 2,\n      \"package_type\": \"CRATE\",\n      \"weight_kg\": 14500,\n      \"volume_cbm\": 38.5\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/shipments" }
          }
        },
        {
          "name": "Get Shipment Details (GET /api/shipments/{id})",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": { "raw": "{{base_url}}/shipments/1" }
          }
        },
        {
          "name": "Update Shipment (PUT /api/shipments/{id})",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weight\": 14600,\n  \"special_instructions\": \"Priority temperature sensitive manifest updated.\"\n}"
            },
            "url": { "raw": "{{base_url}}/shipments/1" }
          }
        },
        {
          "name": "Delete Shipment - Admin only (DELETE /api/shipments/{id})",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": { "raw": "{{base_url}}/shipments/1" }
          }
        }
      ]
    },
    {
      "name": "Tracking & Timeline",
      "item": [
        {
          "name": "Get Shipment Timeline (GET /api/shipments/{id}/tracking)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": { "raw": "{{base_url}}/shipments/1/tracking" }
          }
        },
        {
          "name": "Append Tracking Event (POST /api/shipments/{id}/tracking)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_type\": \"CHECKPOINT_SCAN\",\n  \"location_name\": \"Suez Canal Passage\",\n  \"latitude\": 29.9737,\n  \"longitude\": 32.5599,\n  \"description\": \"Vessel convoy transited Suez Canal northbound checkpoint.\"\n}"
            },
            "url": { "raw": "{{base_url}}/shipments/1/tracking" }
          }
        }
      ]
    },
    {
      "name": "Exceptions & Delay",
      "item": [
        {
          "name": "Get Shipment Exceptions (GET /api/shipments/{id}/exceptions)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": { "raw": "{{base_url}}/shipments/1/exceptions" }
          }
        },
        {
          "name": "Log Exception (POST /api/shipments/{id}/exceptions)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"exception_type\": \"PORT_CONGESTION\",\n  \"severity\": \"MEDIUM\",\n  \"impact_hours\": 18,\n  \"description\": \"Vessel queued at anchorage awaiting container berth assignment.\"\n}"
            },
            "url": { "raw": "{{base_url}}/shipments/1/exceptions" }
          }
        },
        {
          "name": "Update / Resolve Exception (PATCH /api/exceptions/{id})",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"RESOLVED\",\n  \"resolution_notes\": \"Berth assigned at terminal pier 3; discharging operations commenced.\"\n}"
            },
            "url": { "raw": "{{base_url}}/exceptions/1" }
          }
        }
      ]
    },
    {
      "name": "Carriers & Locations",
      "item": [
        {
          "name": "Get Carriers (GET /api/carriers)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": { "raw": "{{base_url}}/carriers" }
          }
        },
        {
          "name": "Create Carrier - Admin only (POST /api/carriers)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"HAPAG\",\n  \"name\": \"Hapag-Lloyd AG\",\n  \"mode\": \"SEA\",\n  \"contact_email\": \"cargo@hapag-lloyd.example.com\",\n  \"website\": \"https://www.hapag-lloyd.com\"\n}"
            },
            "url": { "raw": "{{base_url}}/carriers" }
          }
        },
        {
          "name": "Get Locations (GET /api/locations)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": { "raw": "{{base_url}}/locations" }
          }
        },
        {
          "name": "Create Location - Admin only (POST /api/locations)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"USOAK\",\n  \"name\": \"Port of Oakland\",\n  \"city\": \"Oakland\",\n  \"country\": \"United States\",\n  \"country_code\": \"US\",\n  \"latitude\": 37.7957,\n  \"longitude\": -122.2795,\n  \"type\": \"PORT\"\n}"
            },
            "url": { "raw": "{{base_url}}/locations" }
          }
        }
      ]
    },
    {
      "name": "External Integrations",
      "item": [
        {
          "name": "Fetch Live Weather (GET /api/external/weather)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/external/weather?latitude=51.9540&longitude=4.0530"
            }
          }
        },
        {
          "name": "Geocode Location (GET /api/external/geocode)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/external/geocode?q=Port of Rotterdam"
            }
          }
        }
      ]
    }
  ]
}
