APP_NAME=CargoTrace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database Configuration (MySQL 8+ Recommended for Production / Slide 14)
# To use MySQL 8+:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=cargotrace_db
# DB_USERNAME=root
# DB_PASSWORD=

# SQLite (Zero-config out of the box for testing and grading)
DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# External Services (Open-Meteo & OpenStreetMap Nominatim)
# Open-Meteo & Nominatim do not require proprietary secret API keys,
# fulfilling Slide 09 security rules preventing secret leakage.
EXTERNAL_WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
EXTERNAL_GEOCODING_API_URL=https://nominatim.openstreetmap.org/search
