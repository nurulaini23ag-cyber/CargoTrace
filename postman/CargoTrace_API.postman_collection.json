      ]
    },
    {
      "name": "06. External Services Integration",
      "item": [
        {
          "name": "Open-Meteo Marine Weather Query",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/external/weather?latitude=3.7833&longitude=98.6833",
              "host": ["{{base_url}}"],
              "path": ["external", "weather"],
              "query": [
                {
                  "key": "latitude",
                  "value": "3.7833"
                },
                {
                  "key": "longitude",
                  "value": "98.6833"
                }
              ]
            }
          }
        },
        {
          "name": "OpenStreetMap Nominatim Geocoding",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{auth_token}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/external/geocode?q=Port+of+Rotterdam",
              "host": ["{{base_url}}"],
              "path": ["external", "geocode"],
              "query": [
                {
                  "key": "q",
                  "value": "Port of Rotterdam"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
